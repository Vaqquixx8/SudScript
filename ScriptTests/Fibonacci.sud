let fibonacciCount = random(1, 186)

// Inefficient, but I wanted to test lists
let results = []

func main()
{
    let i = 1

    while(i <= fibonacciCount)
    {
        results:add(fibonacci(i))
        say("The " + i + getNumberSuffix(i) + " Fibonacci Number is: " + results:get(i-1))
        i = i + 1
    }
}

func getNumberSuffix(number)
{
    let lastTwo = number % 100

    if(lastTwo == 11 || lastTwo == 12 || lastTwo == 13)
    {
        return "th"
    }
    let last = number % 10

    if(last == 1)
    {
        return "st"
    }
    else if(last == 2)
    {
        return "nd"
    }
    else if(last == 3)
    {
        return "rd"
    }
    return "th"
}

func fibonacci(n)
{
    if(n == 0)
    {
        return 0
    }

    let prev = 0
    let next = 1

    let i = 1
    while(i < n)
    {
        let sum = prev + next
        prev = next
        next = sum

        i = i + 1
    }
    return next
}