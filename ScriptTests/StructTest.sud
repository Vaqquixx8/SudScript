struct Vector2
{
    let x = 0
    let y = 0

    // All instances of structs have an explicit "self"
    func add(other)
    {
        return Vector2{x = self:x + other:x, y = self:y + other:y}
    }

    shared func add(a, b)
    {
        return Vector2{x = a:x + b:x, y = a:y + b:y}
    }

    shared func normalize(vec)
    {
        let len = sqrt(vec:x * vec:x + vec:y * vec:y)
        if(len != 0)
        {
            let invLen = 1 / len
            return Vector2{x = vec:x * invLen, y = vec:y * invLen}
        }
        return Vector2{}
    }
}

let playerPosition = Vector2{x = 10, y = 10}

func main()
{
    // Shared and Instanced struct functions with the same name can be used independantly

    let newPosition1 = Vector2:add(Vector2{x = 5, y = 5}, playerPosition)
    newPosition1 = newPosition1:add(Vector2{x = 1, y = 1})
    say(newPosition1)
}