struct Vector2
{
    let x = 0
    let y = 0

    // All instances of structs have an explicit "self"
    func add(other)
    {
        return Vector2{x = self:x + other:x, y = self:y + other:y}
    }

    shared func add(a, b)
    {
        return Vector2{x = a:x + b:x, y = a:y + b:y}
    }

    shared func normalize(vec)
    {
        let len = sqrt(vec:x * vec:x + vec:y * vec:y)
        if(len != 0)
        {
            let invLen = 1 / len
            return Vector2{x = vec:x * invLen, y = vec:y * invLen}
        }
        return Vector2{}
    }
}
